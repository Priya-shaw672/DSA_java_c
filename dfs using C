#include <stdio.h>
#define max 3

void depth(int arr[max][max], int visited[], int start) {
    int stack[max];
    int top = -1, i;

    visited[start] = 1;
    stack[++top] = start;

    printf("%c", start + 65); // Print the starting node (A, B, C...)

    while (top != -1) {
        start = stack[top];
        for (i = 0; i < max; i++) {
            if (arr[start][i] && visited[i] == 0) {
                stack[++top] = i;
                printf("%c", i + 65); // Print the visited node
                visited[i] = 1;
                break;
            }
        }
        if (i == max) 
            top--;
    }
}

void main() {
    int adj[max][max];
    int visited[max] = {0}, i, j;

    printf("Enter the adjacency matrix:\n");
    for (i = 0; i < max; i++) {
        for (j = 0; j < max; j++) {
            scanf("%d", &adj[i][j]);
        }
    }

    printf("DFS traversal: ");
    depth(adj, visited, 0); // Start DFS from node 0
    printf("\n");
}
