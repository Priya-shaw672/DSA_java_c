#include<stdio.h>
#define size 5  // Define the size of the queue

void empty();
void full();
void enqueue();
void dequeue();
void peek();

int queue[size], rear = -1, front = -1;

void main() {
    int choice;
    while (1) {
        printf("\nQueue Operations Menu:");
        printf("\n1. Enqueue");
        printf("\n2. Dequeue");
        printf("\n3. Peek");
        printf("\n4. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1: enqueue(); break;
            case 2: dequeue(); break;
            case 3: peek(); break;
            case 4: return;
            default: printf("Invalid choice. Please try again.\n");
        }
    }
}

void empty() {
    if (front == -1 && rear == -1) {
        printf("The queue is empty.\n");
    } else {
        printf("The queue is not empty.\n");
    }
}

void full() {
    if ((front == 0 && rear == size - 1) || (rear == front - 1)) {
        printf("The queue is full.\n");
    } else {
        printf("The queue is not full.\n");
    }
}

void enqueue() {
    int data;
    if ((front == 0 && rear == size - 1) || (rear == front - 1)) {
        printf("Queue is full! Cannot enqueue.\n");
        return;
    }
    printf("Enter the data to insert: ");
    scanf("%d", &data);
    if (rear == -1) {  // First element
        rear = 0;
        front = 0;
    } else if (rear == size - 1 && front != 0) {
        rear = 0;  // Circular condition
    } else {
        rear++;
    }
    queue[rear] = data;
    printf("Inserted data: %d\n", data);
}

void dequeue() {
    if (front == -1 && rear==-1) {
        printf("Queue is empty! Cannot dequeue.\n");
        return;
    }
    printf("Removed data: %d\n", queue[front]);
    if (front == rear) {  // Only one element
        front = -1;
        rear = -1;
    } else if (front == size - 1) {// at the last index
        front = 0;  // Circular condition
    } else {
        front++;
    }
}

void peek() {
    if (front == -1) {
        printf("Queue is empty! No elements to peek.\n");
        return;
    }
    printf("Front element: %d\n", queue[front]);
}
